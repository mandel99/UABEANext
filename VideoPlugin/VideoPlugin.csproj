<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UABEANext4/UABEANext4.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="../Libraries/AssetsTools.NET/AssetTools.NET/AssetsTools.NET.csproj" />
  </ItemGroup>
  <Target Name="CopyVideoPluginBuild" AfterTargets="AfterBuild" Condition="'$(SolutionDir)' != '' AND '$(SolutionDir)' != '*Undefined*'">
    <Copy SourceFiles="$(OutputPath)VideoPlugin.dll" DestinationFolder="$(SolutionDir)UABEANext4.Desktop/$(OutputPath)plugins" />
  </Target>
  <Target Name="CopyVideoPluginPublish" AfterTargets="Publish" Condition="'$(SolutionDir)' != '' AND '$(SolutionDir)' != '*Undefined*'">
    <Copy SourceFiles="$(PublishDir)VideoPlugin.dll" DestinationFolder="$(SolutionDir)UABEANext4.Desktop/$(PublishDir)plugins" />
  </Target>
</Project>
